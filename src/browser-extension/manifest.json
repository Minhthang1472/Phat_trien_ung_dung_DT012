{
  "manifest_version": 3,
  "name": "PHỤ ĐỀ BÀI GIẢNG TỰ ĐỘNG",
  "version": "1.4.1",
  "description": "Tự động tạo phụ đề đồng bộ đa ngôn ngữ, song ngữ và tóm tắt bài giảng trực tiếp trên trình duyệt (YouTube, Drive, LMS...)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*.trycloudflare.com/*",
    "https://firestore.googleapis.com/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.coursera.org/*",
    "*://*.edx.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PHỤ ĐỀ BÀI GIẢNG TỰ ĐỘNG",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.coursera.org/*",
        "*://*.edx.org/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
