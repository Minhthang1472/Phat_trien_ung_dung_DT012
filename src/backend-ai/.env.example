# Cấu hình Server
PORT=8000
HOST=127.0.0.1

# Cấu hình Cơ sở dữ liệu Cloud Firebase Firestore
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=ptud-dt012

# Cấu hình Mô hình Whisper AI
# Các kích cỡ: "tiny", "base", "small", "medium" (Khuyên dùng "base" hoặc "small" cho GPU RTX 2050 4GB)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# API Key Gemini (Dùng để tóm tắt bài giảng miễn phí)
GEMINI_API_KEY=your_gemini_api_key_here

# Tùy chọn: Ollama cục bộ (dùng khi không cấu hình GEMINI_API_KEY)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# FFmpeg dùng để ghi cứng phụ đề vào MP4. Có thể là tên executable hoặc đường dẫn tuyệt đối.
FFMPEG_PATH=ffmpeg
JWT_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
MAX_REFRESH_SESSIONS=5
REFRESH_REPLAY_GRACE_SECONDS=300
MEDIA_TOKEN_TTL_MINUTES=120
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Bảo vệ /metrics (>= 16 ký tự). Để trống: /metrics trả 404 ở production.
METRICS_TOKEN=
# Token API quản trị (/api/admin, >= 32 ký tự). Để trống: API quản trị trả 404.
ADMIN_TOKEN=
# Mặc định tắt /docs ở production; bật bằng ENABLE_DOCS=true nếu cần.
ENABLE_DOCS=false
# Giới hạn kênh Live-Caption WebSocket: số kết nối đồng thời và buffer tối đa (byte).
WS_MAX_CONNECTIONS=20
WS_MAX_BUFFER_BYTES=5242880
# Dịch phụ đề: số request Google chạy song song, số worker của pool dịch và số mục cache RAM.
TRANSLATION_MAX_CONCURRENCY=4
TRANSLATION_WORKERS=6
TRANSLATION_CACHE_SIZE=5000
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_sender@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_sender@gmail.com
PUBLIC_API_URL=http://127.0.0.1:8000
ALLOWED_VIDEO_HOSTS=youtube.com,youtu.be,drive.google.com,drive.usercontent.google.com,docs.google.com
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Host header được phép; development dùng '*' cho tiện truy cập qua IP LAN.
ALLOWED_HOSTS=*
# Tùy chọn: dùng Redis cho rate limit phân tán (để trống sẽ dùng bộ nhớ cục bộ)
REDIS_URL=
# IP/CIDR của reverse proxy tin cậy, phân tách bằng dấu phẩy. Chỉ khi request
# đến từ các địa chỉ này backend mới đọc X-Forwarded-For để lấy IP người dùng.
TRUSTED_PROXIES=

# Vận hành
ENVIRONMENT=development
LOG_LEVEL=INFO
# Tự động xoá file media trong uploads/, audio tạm và job streaming cũ
UPLOAD_TTL_HOURS=24
AUDIO_TEMP_TTL_HOURS=6
STREAM_JOB_TTL_MINUTES=120
CLEANUP_INTERVAL_MINUTES=30
