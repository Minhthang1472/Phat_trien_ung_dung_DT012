# Mẫu cấu hình cho Docker Compose ở thư mục gốc.
# Sao chép thành .env rồi điền giá trị thật:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)

API_PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# Bắt buộc: chuỗi ngẫu nhiên dài >= 32 ký tự
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRE_HOURS=168
# Token gắn vào URL file /uploads/... (phút). Mobile tự gia hạn trước khi hết hạn.
MEDIA_TOKEN_TTL_MINUTES=120

# Firebase
FIREBASE_PROJECT_ID=ptud-dt012

# AI
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLIENT_ID=
# Tùy chọn: dùng Ollama cục bộ khi không có GEMINI_API_KEY
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Email OTP (để trống SMTP_USERNAME/SMTP_PASSWORD nếu chưa cấu hình;
# backend sẽ tự kích hoạt tài khoản khi không gửi được email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# URL công khai của backend (dùng khi tạo link media/stream)
PUBLIC_API_URL=http://localhost:8000
# Danh sách host được phép tải video (chống SSRF), phân tách bằng dấu phẩy
ALLOWED_VIDEO_HOSTS=youtube.com,youtu.be,drive.google.com,drive.usercontent.google.com,docs.google.com,dropbox.com

# Tùy chọn: Redis cho rate limit phân tán (mặc định dùng bộ nhớ cục bộ)
REDIS_URL=

# Whisper (CPU mặc định; đổi sang cuda nếu có GPU NVIDIA + NVIDIA Container Toolkit)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
FFMPEG_PATH=ffmpeg

# Ứng dụng khách được phép gọi API
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Dọn dẹp tài nguyên tạm
UPLOAD_TTL_HOURS=24
AUDIO_TEMP_TTL_HOURS=6
STREAM_JOB_TTL_MINUTES=120
CLEANUP_INTERVAL_MINUTES=30
