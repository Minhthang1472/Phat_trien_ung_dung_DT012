# Mẫu cấu hình cho Docker Compose ở thư mục gốc.
# Sao chép thành .env rồi điền giá trị thật:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)

API_PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# Bắt buộc: chuỗi ngẫu nhiên dài >= 32 ký tự
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRE_HOURS=168

# Firebase
FIREBASE_PROJECT_ID=ptud-dt012

# AI
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLIENT_ID=

# Whisper (CPU mặc định; đổi sang cuda nếu có GPU NVIDIA + NVIDIA Container Toolkit)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
FFMPEG_PATH=ffmpeg

# Ứng dụng khách được phép gọi API
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Dọn dẹp tài nguyên tạm
UPLOAD_TTL_HOURS=24
STREAM_JOB_TTL_MINUTES=120
CLEANUP_INTERVAL_MINUTES=30
