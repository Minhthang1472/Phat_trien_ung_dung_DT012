# Cấu hình Server
PORT=8000
HOST=127.0.0.1

# Cấu hình Cơ sở dữ liệu Cloud Firebase Firestore
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=ptud-dt012

# Cấu hình Mô hình Whisper AI
# Các kích cỡ: "tiny", "base", "small", "medium" (Khuyên dùng "base" hoặc "small" cho GPU RTX 2050 4GB)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# API Key Gemini (Dùng để tóm tắt bài giảng miễn phí)
GEMINI_API_KEY=your_gemini_api_key_here

# FFmpeg dùng để ghi cứng phụ đề vào MP4. Có thể là tên executable hoặc đường dẫn tuyệt đối.
FFMPEG_PATH=ffmpeg
