# Cấu hình Server
PORT=8000
HOST=127.0.0.1

# Cấu hình MongoDB (Dán connection string từ MongoDB Atlas hoặc Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=lecture_caption_db

# Cấu hình Mô hình Whisper AI
# Các kích cỡ: "tiny", "base", "small", "medium" (Khuyên dùng "base" hoặc "small" cho GPU RTX 2050 4GB)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# API Key Gemini (Dùng để tóm tắt bài giảng miễn phí)
GEMINI_API_KEY=your_gemini_api_key_here
