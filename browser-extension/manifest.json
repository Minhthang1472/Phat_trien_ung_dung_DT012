{
  "manifest_version": 3,
  "name": "PHỤ ĐỀ BÀI GIẢNG AI",
  "version": "1.2.0",
  "description": "Tự động tạo phụ đề đồng bộ đa ngôn ngữ, song ngữ và tóm tắt bài giảng trực tiếp trên trình duyệt (YouTube, Drive, LMS...)",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PHỤ ĐỀ BÀI GIẢNG AI"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
